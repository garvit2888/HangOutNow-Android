rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to check if user is a member of an activity
    function isActivityMember(activityId) {
      let activityData = get(/databases/$(database)/documents/activities/$(activityId)).data;
      return isAuthenticated() && 
             activityData.members != null &&
             activityData.members is list &&
             activityData.members.hasAny(['id'], [request.auth.uid]);
    }
    
    // User profiles - only owner can write, anyone authenticated can read
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // User chats - only owner can read/write their own chats
    match /userChats/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // Activities - authenticated users can create/read/update
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                       request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && 
                       resource.data.createdBy == request.auth.uid;
      
      // Chat messages - only activity members can access
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isActivityMember(activityId);
        allow create: if isAuthenticated() && 
                         request.resource.data.senderId == request.auth.uid &&
                         isActivityMember(activityId);
        allow update: if false; // Messages cannot be edited
        allow delete: if isAuthenticated() && 
                         resource.data.senderId == request.auth.uid;
      }
    }
    
    // Reports (for future use)
    match /reports/{reportId} {
      allow read: if false; // Only admins can read (implement admin check)
      allow create: if isAuthenticated();
    }
  }
}

